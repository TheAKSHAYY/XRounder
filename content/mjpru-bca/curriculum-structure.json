{
  "university": "Mahatma Jyotiba Phule Rohilkhand University (MJPRU), Bareilly",
  "program": "Bachelor of Computer Application (BCA)",
  "effective_session": "2024-25 onwards",
  "examination_scheme": {
    "theory_max_marks": 100,
    "internal_assessment": 30,
    "external_examination": 70,
    "min_passing_percentage": 40,
    "practical_min_passing_percentage": 50
  },
  "semesters": [
    {
      "semester": 1,
      "year": 1,
      "subjects": [
        {
          "code": "BCA-101N",
          "title": "Computer Fundamentals and PC Software",
          "type": "Theory (Core Compulsory)",
          "credits": 4,
          "units": [
            { "unit": 1, "title": "Computers Evolution, Architecture, Memory & Software Types" },
            { "unit": 2, "title": "Overview of Operating Systems, DOS & Windows Management" },
            { "unit": 3, "title": "PC Maintenance, Hardware, Motherboard & Internet Fundamentals" },
            { "unit": 4, "title": "Word Processing (MS Word) & Presentation (MS PowerPoint)" },
            { "unit": 5, "title": "Spreadsheet (MS Excel) - Formulas, Functions & Macros" }
          ]
        },
        {
          "code": "BCA-103N",
          "title": "Programming with C",
          "type": "Theory (Core Compulsory)",
          "credits": 4,
          "units": [
            { "unit": 1, "title": "C Fundamentals, Structure, Data Types & Operators" },
            { "unit": 2, "title": "Control Statements, Branching & Looping Constructs" },
            { "unit": 3, "title": "Arrays, 2D Arrays, Strings & String Handling Functions" },
            { "unit": 4, "title": "Functions, Parameter Passing, Recursion & Scope" },
            { "unit": 5, "title": "Pointers, Structures, Unions & Dynamic Memory Allocation" }
          ]
        },
        {
          "code": "BCA-105N",
          "title": "Basic Mathematics",
          "type": "Theory (Core Compulsory)",
          "credits": 4,
          "units": [
            { "unit": 1, "title": "Divisibility, Prime Factorization, Fractions & Binomial Theorem" },
            { "unit": 2, "title": "Sequences, Series & Progressions (AP, GP, HP, AM, GM, HM)" },
            { "unit": 3, "title": "Matrices and Determinants - Operations & Inverse" },
            { "unit": 4, "title": "Differential Calculus - Chain Rule, Logs, Trigonometric Differentiation" },
            { "unit": 5, "title": "Integral Calculus - Substitution, Trigonometric Identities & Parts" }
          ]
        },
        {
          "code": "BCA-107N",
          "title": "Communicative English",
          "type": "Theory (Core Compulsory)",
          "credits": 4,
          "units": [
            { "unit": 1, "title": "Language Communication, Process, Components & Barriers" },
            { "unit": 2, "title": "English Skills - Reading, Listening, Verbal & Non-Verbal Techniques" },
            { "unit": 3, "title": "Effective Writing - Abstracts, Summaries, Notes & Technical Reports" },
            { "unit": 4, "title": "Grammar I - Parts of Speech, Subject-Predicate, Phrases, Clauses & Tenses" },
            { "unit": 5, "title": "Grammar II - Active/Passive Voice, Concord & Reported Speech" }
          ]
        },
        {
          "code": "BCA-109N",
          "title": "Principle of Management",
          "type": "Theory (Core Compulsory)",
          "credits": 4,
          "units": [
            { "unit": 1, "title": "Management Fundamentals, Fayol & Taylor Principles, Theories" },
            { "unit": 2, "title": "Planning, Decision Making, Organizing & Departmentation" },
            { "unit": 3, "title": "Staffing, Directing, Motivation (Maslow, Herzberg) & Controlling" },
            { "unit": 4, "title": "Organizational Behavior - Personality, Learning, Perception & Attitudes" },
            { "unit": 5, "title": "Computer Applications in Functional Management (Finance, HR, Mktg)" }
          ]
        },
        {
