# Supabase Configuration
# Get these values from your Supabase project settings
# https://app.supabase.com/project/_/settings/api

# Public URL of your Supabase project
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key (safe to expose to browser)
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Server-side variables (do NOT expose to browser)
# Keep these secret in your production environment
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
SUPABASE_PROJECT_ID=your-project-id

# Gemini AI Study Assistant
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest

# FreeLLM / Multi-Model OpenAI-Compatible Gateway (Optional)
# If using a self-hosted or managed FreeLLM proxy gateway:
FREELLM_API_KEY=your-freellm-api-key-here
FREELLM_BASE_URL=https://api.freellm.net/v1

# Inception Labs / Mercury 3 (Optional direct access)
# If using direct Inception Labs API for Mercury 3 diffusion LLM:
MERCURY_API_KEY=your-mercury-api-key-here
MERCURY_BASE_URL=https://api.inceptionlabs.ai/v1


